{
  "name": "finagent-workstation",
  "version": "0.1.0",
  "description": "FinAgent Desktop — AI-powered finance workstation",
  "main": "out/main/index.js",
  "bin": {
    "finagent-workstation": "out/main/run-service-cli.js"
  },
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy_webview_preload.cjs",
    "start": "electron-vite dev",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:tdx:manual": "vitest run --config vitest.manual.config.ts scripts/manual-tests/tdx-contract.manual.ts",
    "test:akshare:manual": "vitest run --config vitest.manual.config.ts scripts/manual-tests/akshare-contract.manual.ts",
    "test:finance-api:manual": "vitest run --config vitest.manual.config.ts scripts/manual-tests/eastmoney-akshare-full.manual.ts",
    "test:data-feeds:manual": "vitest run --config vitest.manual.config.ts scripts/manual-tests/data-feed-prefetch.manual.ts",
    "probe:finance-live": "node scripts/finance_live_probe_matrix.mjs",
    "inventory:finance-api": "node scripts/finance_api_surface_inventory.mjs --output reports/finance_api_surface_inventory.json",
    "status:finance-api": "node scripts/finance_api_status_report.mjs",
    "status:finance-mobile": "node scripts/finance_mobile_api_status_report.mjs",
    "matrix:data-api-providers": "node scripts/finance_data_api_provider_matrix.mjs",
    "matrix:detailed-api-calls": "node scripts/finance_detailed_api_call_provider_matrix.mjs",
    "audit:data-api-completion": "node scripts/finance_data_api_completion_audit.mjs",
    "audit:finance-schema": "node scripts/finance_schema_governance_audit.mjs",
    "matrix:finance-datastore": "node scripts/finance_api_datastore_matrix.mjs",
    "report:finance-api": "node scripts/generate_finance_api_report.cjs",
    "workflow:scenario": "node scripts/run_workflow_scenario_sequence.mjs",
    "run-service": "node out/main/run-service-cli.js",
    "test:watch": "vitest",
    "migrate:project-data": "node scripts/migrate_project_data_by_cwd.cjs",
    "test:e2e": "npx electron-vite build && playwright test"
  },
  "dependencies": {
    "allotment": "^1.20.5",
    "highlight.js": "^11.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.0",
    "sql.js": "^1.14.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^42.0.1",
    "electron-vite": "^6.0.0-beta.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
